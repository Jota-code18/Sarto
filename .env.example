# Opcional. Se definida, o painel pede esta senha antes de abrir.
PAINEL_SENHA=
# Chave da Apify. A varredura só liga com as duas definidas.
APIFY_TOKEN=
# Teto em dólar por mês. 4.95 cabe no gratuito; 25 ou mais varre a cidade inteira todo mês.
APIFY_TETO_MES=
# Chave do robô do Canal Pro (mínimo 24 caracteres). A mesma vai no .env.robo do computador da Sarto.
CANALPRO_ROBO_TOKEN=
# Segredo da chamada semanal. Qualquer texto longo; a Vercel envia sozinha.
CRON_SECRET=
# Observabilidade (Sentry). Sem isto, desligada. O DSN é público por natureza.
NEXT_PUBLIC_SENTRY_DSN=
