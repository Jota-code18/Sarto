{
  "name": "sarto-painel",
  "version": "0.1.0",
  "private": true,
  "description": "Painel de gestão da Sarto Imóveis: comercial, locação, jurídico, financeiro, marketing e ADM",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "formatar": "biome check --write .",
    "arquitetura": "depcruise src",
    "morto": "node scripts/morto.mjs",
    "mutacao": "stryker run",
    "verificar": "npm run lint && npm run typecheck && npm run arquitetura && npm run morto && npm test && npm run build && npm run segredos",
    "test:cobertura": "vitest run --coverage",
    "e2e": "playwright test",
    "segredos": "node scripts/segredos.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.17.0",
    "docxtemplater": "3.71.1",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "pizzip": "3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@biomejs/biome": "^2.6.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electric-sql/pglite": "^0.6.0",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.9.0",
    "knip": "^6.48.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
